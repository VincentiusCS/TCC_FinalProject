# Application
PORT=3001
NODE_ENV=development

# Database (erp_master_db)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=erp_master_db

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Google Cloud Storage
GCS_BUCKET_NAME=your-gcs-bucket-name
# Use one of the two options below to provide credentials.
# GCP_KEY_FILE takes precedence over GOOGLE_APPLICATION_CREDENTIALS.
# If neither is set, the client falls back to Application Default Credentials (ADC).
GCP_KEY_FILE=/path/to/service-account-key.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
